# ── Supabase ──────────────────────────────────────────────────────────────────
# Copy these from your Supabase project dashboard → Settings → API.

# Public (safe to expose to the browser via NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only (Next.js server components, Server Actions)
SUPABASE_URL=                  # same as NEXT_PUBLIC_SUPABASE_URL (no NEXT_PUBLIC_ prefix for server)
SUPABASE_SERVICE_ROLE_KEY=     # NEVER expose to the browser

# Worker — direct asyncpg connection (bypasses RLS by design)
# Format: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres
# Local dev (supabase start): postgresql://postgres:postgres@localhost:54322/postgres
# Render/production: use the Supabase "Direct connection" string from Settings → Database
SUPABASE_DB_URL=

# ── LLM (Phase 5+) ────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=

# ── Embeddings (Phase 4) ──────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Search (Phase 3) ──────────────────────────────────────────────────────────
# Use one web-search provider: Brave or Tavily. Semantic Scholar needs no key.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Content extraction fallback (free tier; primary is trafilatura which needs no key)
JINA_API_KEY=

# ── Observability (Phase 5+) ──────────────────────────────────────────────────
LANGCHAIN_API_KEY=
